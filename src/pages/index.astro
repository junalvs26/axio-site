---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import Nav from '../components/Nav.astro';
import Scene from '../components/Scene.astro';
import Services from '../components/Services.astro';
import { scenes } from '../scenes/config';
import { normalizeRanges } from '../scenes/timeline';
import { meta } from '../content/site';

const list = normalizeRanges(scenes);
---
<Base title={meta.title} description={meta.description}>
  <a class="sr-only skip" href="#final">Pular para o contato</a>
  <Nav />
  <Stage />
  <main id="story">
    {list.map((s) => <Scene scene={s} />)}
  </main>
  <Services />
  <script>
    import { boot } from '../runtime/boot';
    boot();
  </script>
</Base>

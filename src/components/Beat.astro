---
import { asset } from '../lib/asset';
import type { Beat } from '../content/site';
import type { SceneId } from '../scenes/types';
import { cta } from '../content/site';

interface Props { beat: Beat; sceneId: SceneId; index: number }
const { beat, sceneId } = Astro.props;
const isHero = sceneId === 'awakening' && beat.kind === 'title';
// O primeiro texto da primeira cena já nasce visível: é o que aparece antes do JS (e o LCP).
const initiallyOn = sceneId === 'prelude' && beat.at === 0;
const stepNo = beat.kind === 'step' ? String(Astro.props.index).padStart(2, '0') : '';
// Títulos e linhas entram palavra por palavra (ver .w no CSS); o texto continua inteiro no HTML.
const words = (text = '') => text.split(' ');
const n = beat.kind === 'list' ? beat.items!.length : words(beat.text).length;
const [lead, key, future] = beat.kind === 'unlock' ? beat.text.split('|') : [];
---
<div class={`beat beat--${beat.kind}${initiallyOn ? ' is-on' : ''}`} style={`--n:${n}${initiallyOn ? ';--in:1' : ''}`} data-at={beat.at} data-until={beat.until} data-kind={beat.kind}>
  {beat.kind === 'kicker' && <p class="kicker"><span class="kicker__tick" aria-hidden="true"></span>{beat.text}</p>}

  {beat.kind === 'title' && isHero && (
    <h1 class="hero-mark">
      <img src={asset('/brand/logo-negativo.png')} alt="Axio" width="1966" height="238" fetchpriority="high" />
    </h1>
  )}
  {beat.kind === 'title' && !isHero && <h2 class="title">{words(beat.text).map((w, k) => <><span class="w" style={`--k:${k}`}>{w}</span>{' '}</>)}</h2>}
  {beat.kind === 'unlock' && (
    <h2 class="unlock">
      <span class="unlock__lead">{lead}</span>
      <span class="unlock__key"><span class="unlock__word">{key}</span><span class="unlock__scan" aria-hidden="true"></span></span>
      <span class="unlock__future">{future}</span>
    </h2>
  )}
  {initiallyOn && <span class="scroll-cue" aria-hidden="true"><span></span></span>}

  {beat.kind === 'line' && <p class="line">{words(beat.text).map((w, k) => <><span class="w" style={`--k:${k}`}>{w}</span>{' '}</>)}</p>}

  {beat.kind === 'list' && (
    <div class="readout">
      <p class="readout__label">{beat.text}</p>
      <ol class="readout__list">
        {beat.items!.map((it, i) => (
          <li style={`--i:${i}`}>
            <span class="readout__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <strong>{it.title}</strong>
            <span class="readout__text">{it.text}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  {beat.kind === 'step' && (
    <article class={`step${stepNo === '02' ? ' step--lift' : ''}`}>
      <p class="step__no">Passo {stepNo}</p>
      <h3 class="step__title">{beat.title}</h3>
      <p class="step__text">{beat.text}</p>
    </article>
  )}

  {beat.kind === 'cta' && (
    <a class="cta-final" href={cta.href} data-cta>
      <span class="cta-final__dot" aria-hidden="true"></span>
      <span>{beat.text}</span>
      <span class="cta-final__arrow" aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>

  .kicker {
    margin: 0; display: inline-flex; align-items: center; gap: .75rem;
    font: 500 .75rem/1 var(--f-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--c-dim);
  }
  .kicker__tick { width: 28px; height: 1px; background: var(--c-orange); }

  .hero-mark { margin: 0; }
  .hero-mark img {
    width: min(68vw, 560px); height: auto;
    /* logo original preservado; só a parte navy precisa de leitura no escuro → filtro aplicado ao conjunto não recolore o laranja */
    filter: drop-shadow(0 0 40px rgb(var(--c-orange-rgb) / .12));
  }

  .title {
    margin: 0; font: 400 clamp(2rem, 4.6vw, 4.5rem)/1.04 var(--f-display);
    letter-spacing: -.02em; text-wrap: balance; max-width: 18ch;
  }
  /* Abertura: a chamada é a primeira coisa na tela; o fio com a luz descendo diz "role". */
  /* Abertura em três camadas sobre o céu de tempestade: rótulo de sistema, palavra que destrava
     (larga e pesada, eixo wdth da Saira) e a promessa em laranja de energia. Sombra escura difusa
     para ler sobre raios e nuvens claras. A animação está em runtime/unlock.ts. */
  .unlock {
    margin: 0; display: grid; justify-items: center; gap: .1em; text-align: center; font-family: var(--f-display);
    text-shadow: 0 2px 4px rgb(var(--c-ink-rgb) / .6), 0 0 40px rgb(var(--c-ink-rgb) / .8);
  }
  .unlock__lead {
    display: inline-flex; align-items: center; gap: 1em; margin-bottom: .6em;
    font-size: clamp(.8rem, 1vw, .95rem); font-weight: 500; letter-spacing: .42em; text-transform: uppercase; color: var(--c-text);
  }
  .unlock__lead::before, .unlock__lead::after { content: ''; width: 2.5em; height: 1px; background: var(--c-orange); }
  .unlock__key {
    position: relative; font-size: clamp(3rem, 10vw, 9rem); font-weight: 600; font-stretch: 118%; line-height: .95;
    letter-spacing: -.02em; color: var(--c-text);
  }
  .unlock__scan {
    position: absolute; left: 0; right: 0; bottom: -.04em; height: 3px; border-radius: 3px; transform-origin: left;
    background: var(--c-orange); box-shadow: 0 0 18px 2px rgb(var(--c-orange-rgb) / .6); opacity: 0;
  }
  .unlock__future {
    --glow: .55;
    font-size: clamp(2.2rem, 7vw, 6.25rem); font-weight: 300; font-stretch: 112%; line-height: 1; letter-spacing: -.01em;
    color: var(--c-orange);
    text-shadow: 0 0 calc(var(--glow) * 48px) rgb(var(--c-orange-rgb) / var(--glow)), 0 2px 4px rgb(var(--c-ink-rgb) / .5);
  }
  /* Até a animação montar o estado inicial, a abertura não pisca inteira (só no cinema; sem JS fica visível). */
  :global(html.is-cinema:not([data-booted])) .unlock { visibility: hidden; }
  .scroll-cue { display: block; width: 2px; height: 72px; margin: 1.75rem auto 0; border-radius: 2px; background: rgb(232 237 245 / .35); overflow: hidden; }
  .scroll-cue span { display: block; width: 100%; height: 40%; background: var(--c-orange); animation: cue 1.8s var(--ease-out) infinite; }
  @keyframes cue { from { transform: translateY(-100%); } to { transform: translateY(260%); } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue span { animation: none; transform: translateY(75%); } }
  .line { margin: 0; font-size: clamp(1.05rem, 1.35vw, 1.3rem); color: var(--c-dim); max-width: 46ch; text-wrap: pretty; }

  /* A lista cai sobre a varredura luminosa do vídeo: um véu local + sombra de texto garantem leitura. */
  .readout {
    position: relative; width: min(100%, 560px); border-top: 1px solid var(--c-line); padding-top: 1rem;
    text-shadow: 0 1px 2px rgb(var(--c-ink-rgb) / .9), 0 0 18px rgb(var(--c-ink-rgb) / .8);
  }
  .readout::before {
    content: ''; position: absolute; inset: -3rem -4rem; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgb(var(--c-ink-rgb) / .88) 40%, transparent);
  }
  .readout__label { margin: 0 0 1.25rem; font: 500 .75rem/1 var(--f-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--c-orange); }
  .readout__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .readout__list li { display: grid; grid-template-columns: 2.5rem 1fr; column-gap: .5rem; row-gap: .2rem; }
  .readout__no { grid-row: span 2; font: 400 .8rem/1.6 var(--f-mono); color: var(--c-steel); }
  .readout__list strong { font: 500 1.15rem/1.3 var(--f-display); letter-spacing: -.01em; }
  .readout__text { color: var(--c-dim); font-size: .98rem; }

  .step { max-width: 34rem; display: grid; gap: .6rem; padding-left: 1.25rem; border-left: 1px solid var(--c-orange); }
  .step__no { margin: 0; font: 500 .9rem/1 var(--f-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--c-orange); }
  .step__title { margin: 0; font: 400 clamp(2.4rem, 6vw, 5.5rem)/1 var(--f-display); letter-spacing: -.03em; }
  .step__text { margin: 0; color: var(--c-text); font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.45; max-width: 38ch; }
  /* TESTE (aprovação pendente): sombra sutil só no passo 02 (Axio OS), para destacar o texto do vídeo. */
  .step--lift { text-shadow: 0 1px 2px rgb(var(--c-ink-rgb) / .55), 0 0 24px rgb(var(--c-ink-rgb) / .65); }

  .cta-final {
    display: inline-flex; align-items: center; gap: .9rem; padding: 1.1rem 1.6rem 1.1rem 1.3rem;
    font: 500 1rem/1 var(--f-display); letter-spacing: .02em; text-decoration: none; color: var(--c-ink);
    background: var(--c-orange); border-radius: 999px;
    box-shadow: 0 0 0 0 rgb(var(--c-orange-rgb) / .5);
    transition: box-shadow .5s var(--ease-out), transform .5s var(--ease-out);
  }
  .cta-final:hover { box-shadow: 0 0 60px 6px rgb(var(--c-orange-rgb) / .35); transform: translateY(-2px); }
  .cta-final__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-ink); }
  .cta-final__arrow { transition: transform .4s var(--ease-out); }
  .cta-final:hover .cta-final__arrow { transform: translateX(4px); }

  /* Modo cinema: entrada (--in) e saída (--out) vêm da rolagem, 0–1, escritas pelo director a cada
     quadro. Nada aqui tem transition: o texto anda junto com o scroll e volta pelo mesmo caminho. */
  :global(html.is-cinema) .beat {
    --in: 0; --out: 0;
    visibility: hidden;
    opacity: calc(var(--in) * (1 - var(--out)));
    transform: translate3d(0, calc((1 - var(--in)) * 20px - var(--out) * 36px), 0);
  }
  :global(html.is-cinema) .beat.is-on { visibility: visible; }
  /* Passos trocam no mesmo lugar, sob o rótulo: sobem pouco ao sair para não encostar nele. */
  :global(html.is-cinema) .beat--step { grid-area: 2 / 1; transform: translate3d(0, calc((1 - var(--in)) * 20px - var(--out) * 10px), 0); }

  /* Palavra k de n: cada uma tem sua janela dentro de --in, duas palavras se sobrepondo por vez. */
  :global(html.is-cinema) .beat--title, :global(html.is-cinema) .beat--line { opacity: calc(1 - var(--out)); }
  :global(html.is-cinema) .w {
    --p: clamp(0, calc((var(--in) * (var(--n) + 2) - var(--k)) / 2), 1);
    display: inline-block; opacity: var(--p);
    transform: translate3d(0, calc((1 - var(--p)) * .45em), 0);
  }
  /* Só os títulos ganham desfoque: poucas palavras grandes, custo limitado. */
  :global(html.is-cinema) .title .w { filter: blur(calc((1 - var(--p)) * 6px)); }

  /* Logo: revelado da esquerda para a direita, como uma varredura. */
  :global(html.is-cinema) .hero-mark { clip-path: inset(0 calc((1 - var(--in)) * 100%) 0 0); }
  :global(html.is-cinema) .beat:has(.hero-mark) { opacity: calc(1 - var(--out)); }

  :global(html.is-cinema) .beat--list li {
    --p: clamp(0, calc((var(--in) * (var(--n) + 2) - var(--i)) / 2), 1);
    opacity: var(--p); transform: translate3d(calc((1 - var(--p)) * -12px), 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.is-cinema) .beat, :global(html.is-cinema) .w, :global(html.is-cinema) .beat--list li { transform: none; }
    :global(html.is-cinema) .title .w { filter: none; }
    :global(html.is-cinema) .hero-mark { clip-path: none; opacity: var(--in); }
  }
</style>

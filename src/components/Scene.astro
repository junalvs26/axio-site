---
import type { Scene } from '../scenes/types';
import { beats, chapters } from '../content/site';
import Beat from './Beat.astro';
import { STORY_VH } from '../scenes/config';

interface Props { scene: Scene }
const { scene } = Astro.props;
const list = beats[scene.id] ?? [];
const heightVh = Math.round((scene.range[1] - scene.range[0]) * STORY_VH);
---
<section
  class="scene"
  id={scene.id}
  data-scene={scene.id}
  style={`--scene-h:${heightVh}vh`}
  aria-label={chapters[scene.id]}
>
  <div class="scene__frame">
    <div class="scene__beats" data-layout={scene.id}>
      {list.map((b, i) => <Beat beat={b} sceneId={scene.id} index={i} />)}
    </div>
  </div>
  {scene.media.poster && (
    <img class="scene__poster" src={scene.media.poster} alt="" loading="lazy" decoding="async" />
  )}
</section>

<style>
  .scene { position: relative; z-index: 2; }
  .scene__frame {
    min-height: 100svh;
    padding: calc(var(--nav-h) + 6vh) var(--gutter) 10vh;
    display: grid;
  }
  .scene__beats { position: relative; display: grid; gap: 1.25rem; align-content: end; max-width: 1440px; width: 100%; margin: 0 auto; }
  .scene__poster { display: none; }

  /* Composições por cena: o texto nunca fica no mesmo lugar duas vezes. */
  [data-layout='prelude'] { align-content: end; justify-items: center; text-align: center; padding-bottom: 8vh; }
  [data-layout='awakening'] { align-content: center; justify-items: center; text-align: center; padding-top: 22vh; }
  [data-layout='city'] { align-content: end; max-width: 1440px; }
  [data-layout='city'] > :global(*) { max-width: 26ch; }
  /* ch do bloco é medido na fonte do corpo; o título já se limita em 18ch na própria fonte. */
  [data-layout='city'] > :global(.beat--title) { max-width: none; }
  [data-layout='city'] > :global(.beat--line) { max-width: 46ch; }
  /* O feixe e o clarão do vídeo ficam na metade de cima: o texto mora no terço escuro de baixo. */
  [data-layout='analysis'] { align-content: end; justify-items: start; padding-bottom: 7vh; }
  [data-layout='analysis'] :global(.readout) { width: min(100%, 880px); }
  @media (min-width: 900px) {
    [data-layout='analysis'] :global(.readout__list) { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
  }
  /* Como funciona: lista um pouco maior que a da varredura. */
  [data-layout='solution'] :global(.readout__label) { font-size: .85rem; }
  [data-layout='solution'] :global(.readout__list strong) { font-size: clamp(1.25rem, 1.7vw, 1.5rem); }
  [data-layout='solution'] :global(.readout__text) { font-size: clamp(1.05rem, 1.3vw, 1.2rem); color: var(--c-text); }
  /* Celular: a lista vira uma coluna alta; encosta embaixo e aperta os itens para não subir até o feixe. */
  @media (max-width: 899px) {
    [data-layout='analysis'] { padding-bottom: 3vh; gap: .75rem; }
    [data-layout='analysis'] :global(.readout__list) { gap: .7rem; }
  }
  [data-layout='action'] { align-content: end; }
  [data-layout='solution'] { align-content: center; }
  [data-layout='transformation'] { align-content: start; justify-items: end; text-align: right; padding-top: 8vh; }
  [data-layout='final'] { align-content: center; justify-items: center; text-align: center; padding-top: 38vh; }

  :global(html.is-cinema) .scene__beats {
    will-change: transform;
  }

  /* Modo cinema: a seção ganha altura de scroll e o quadro fica fixo enquanto a cena roda. */
  :global(html.is-cinema) .scene { height: var(--scene-h); }
  :global(html.is-cinema) .scene__frame { position: sticky; top: 0; height: 100svh; min-height: 0; overflow: hidden; }

  /* Modo estático (sem JS / movimento reduzido): poster como ilustração editorial. */
  :global(html:not(.is-cinema)) .scene__poster {
    display: block; width: min(100% - 2 * var(--gutter), 1200px); margin: 0 auto 12vh;
    aspect-ratio: 16 / 9; object-fit: cover; border-radius: 2px;
  }
</style>

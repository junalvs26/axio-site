---
import { asset } from '../lib/asset';
---
<!-- Topo: só a marca. O palco (vídeo) e os textos carregam a história. -->
<header class="nav">
  <a class="nav__brand" href="#prelude" aria-label="Axio — voltar ao início">
    <img src={asset('/brand/logo-negativo.png')} alt="" width="1966" height="238" />
  </a>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 10; height: var(--nav-h);
    display: flex; align-items: center; padding: 0 var(--gutter);
    pointer-events: none;
  }
  .nav__brand { pointer-events: auto; display: inline-flex; min-height: 44px; align-items: center; }
  .nav__brand img { width: 108px; height: auto; }
  @media (max-width: 720px) { .nav__brand img { width: 88px; } }
</style>
